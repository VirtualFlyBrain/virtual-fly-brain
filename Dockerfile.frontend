# Development image for the Vite frontend: installs dependencies and runs the dev server.
# The deployed application is built by applications/virtual-fly-brain/Dockerfile.
FROM node:20-bookworm-slim

WORKDIR /app

RUN apt-get update && \
    apt-get install -y \
    git curl \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies first so this layer is reused when only the source changes
COPY applications/virtual-fly-brain/frontend/package.json applications/virtual-fly-brain/frontend/yarn.lock ./
RUN yarn config set ignore-engines true \
    && yarn install

# Configuration and source
COPY applications/virtual-fly-brain/frontend/index.html applications/virtual-fly-brain/frontend/vite.config.js applications/virtual-fly-brain/frontend/eslint.config.js applications/virtual-fly-brain/frontend/.env ./
COPY applications/virtual-fly-brain/frontend/src ./src
COPY applications/virtual-fly-brain/frontend/public ./public

# vite.config.js sets server.open; there is no browser to open in a container
ENV BROWSER=none

EXPOSE 3300

CMD ["yarn", "dev", "--host", "0.0.0.0", "--port", "3300"]
